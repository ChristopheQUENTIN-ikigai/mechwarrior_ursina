    "ground": {
        "_comment": "Flat floor plane added by every map so the world is not see-through. y_top is the walkable surface height.",
        "y_top": 0.0,
        "tile_repeat": 0.25,
        "megacity": { "texture": "concrete", "tint": [70, 72, 78],  "margin": 60 },
        "arena_flat": { "texture": "metal",   "tint": [60, 62, 70],  "margin": 12 },
        "canyon":   { "texture": "ground",   "tint": [120, 100, 75], "margin": 30 }
    },

    "lighting": {
        "sun_direction": [1, -0.7, 0.3],
        "ambient_color": [110, 110, 130, 255],
        "sun_sphere": {
            "enabled": true, "distance": 500, "size": 30,
            "color": [255, 230, 80], "direction": "east", "elevation_degrees": 45
