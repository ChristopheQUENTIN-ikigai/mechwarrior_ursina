{
    "_comment": "Mech Tactical Arena - Configuration File (patched: 5 weapons + hardpoints + HUD)",

    "window": {
        "title": "Mech Tactical Arena Prototype",
        "fullscreen": true
    },

    "game_speed": 2.0,

    "camera": {
        "pivot_height": 6,
        "default_distance": 28,
        "min_distance": 8,
        "max_distance": 50,
        "height_offset": 6,
        "height_per_zoom": 0.3,
        "pitch": 15,
        "pitch_min": -30,
        "pitch_max": 60,
        "zoom_speed": 4,
        "zoom_smooth": 6,
        "collision_smooth": 10,
        "return_smooth": 4
    },

    "mouse": {
        "sensitivity_x": 80,
        "sensitivity_y": 40,
        "locked": true
    },

    "keybinds": {
        "_comment": "AZERTY native: Z=forward, S=back, Q=strafe left, D=strafe right.",

        "forward":       ["w", "z", "up arrow"],
        "backward":      ["s", "down arrow"],
        "strafe_left":   ["q", "a"],
        "strafe_right":  ["d", "e"],
        "turn_left":     ["left arrow"],
        "turn_right":    ["right arrow"],
        "jetpack":       "space",

        "fire_gatling":   "left mouse down",
        "fire_railgun":   "right mouse down",
        "fire_rocketpod": "1",
        "fire_heatseeker":"2",
        "fire_sniper":    "3",
        "fire_laser":     "4",
        "fire_gauss":     "5",

        "speed_up":      ["+", "="],
        "speed_down":    ["-", "_"],

        "quit":          "escape",
        "fullscreen":    "f",
        "zoom_in":       "scroll up",
        "zoom_out":      "scroll down"
    },

    "player": {
        "spawn_position": [0, 2, 0],
        "spawn_heading": 0,
        "speed": 6,
        "strafe_speed": 4.5,
        "turn_speed": 70,
        "hp": 200,
        "max_heat": 100,
        "heat_dissipation": 6,
        "collision_margin": 4.0,
        "gravity": 20,
        "jetpack_thrust": 18,
        "max_fuel": 100,
        "fuel_burn_rate": 25,
        "fuel_regen_rate": 10
    },

