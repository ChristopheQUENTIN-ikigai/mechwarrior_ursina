            "factory":      { "weight": 0.08, "w_min": 8,  "w_max": 15, "d_min": 6,  "d_max": 12, "h_min": 6,  "h_max": 11, "texture": "factory" },
            "manufacture":  { "weight": 0.06, "w_min": 9,  "w_max": 18, "d_min": 8,  "d_max": 15, "h_min": 8,  "h_max": 14, "texture": "manufacture" },
            "station":      { "weight": 0.05, "w_min": 12, "w_max": 21, "d_min": 5,  "d_max": 8,  "h_min": 5,  "h_max": 8,  "texture": "station" },
            "airport":      { "weight": 0.03, "w_min": 18, "w_max": 30, "d_min": 12, "d_max": 21, "h_min": 5,  "h_max": 8,  "texture": "airport" },
            "food_shop":    { "weight": 0.10, "w_min": 3,  "w_max": 6,  "d_min": 3,  "d_max": 6,  "h_min": 3,  "h_max": 6,  "texture": "food_shop" },
            "warehouse":    { "weight": 0.07, "w_min": 8,  "w_max": 12, "d_min": 6,  "d_max": 11, "h_min": 5,  "h_max": 9,  "texture": "warehouse" }
