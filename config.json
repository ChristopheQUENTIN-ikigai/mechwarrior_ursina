    "hud": {
        "compass_y": 0.42,
        "compass_bg_scale": [0.60, 0.04],
        "compass_heading_scale": 0.6,
        "bar_x": -0.82,
        "bar_w": 0.25,
        "bar_top_y": 0.46,
        "bar_spacing": 0.035,
        "crosshair_scale": 0.025,
        "crosshair_thickness": 0.0035
