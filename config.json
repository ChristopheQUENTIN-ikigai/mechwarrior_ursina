    "enemies": {
        "squad_size": 4,
        "squad_spawn": [80, 0, 60],
        "hp": 80,
        "speed": 3,
        "attack_range": 40,
        "chase_range": 60,
        "fire_cooldown": 1.5,
        "projectile_speed": 25,
        "projectile_damage": 15
